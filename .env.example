# 复制本文件为 .env 并填入真实值；.env 不会提交到 git（见 .gitignore）。
# 格式：纯 KEY=VALUE，每行一条；# 开头为注释。
# 注意：按 properties 格式解析，请勿使用 `export` 前缀或行内注释（值含 # 时请把注释另起一行）。
# 未设置的项回退到 application.yaml 中的默认值；OS 环境变量优先级高于 .env。

# ===== 默认管理员 =====
# 启用后，后端启动时会创建该邮箱账号；同邮箱已存在时不会改写密码或权限。
DEFAULT_ADMIN_ENABLED=false
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-password
DEFAULT_ADMIN_FIXED_TOKEN_ENABLED=false
DEFAULT_ADMIN_FIXED_TOKEN=replace-with-a-long-random-token

# ===== 第三方登录扩展组件 =====
# 站点对外地址（构造 redirect_uri 用）；同域反代可留空。前后端分域部署时 FRONTEND_URL 必填。
FOXSKIN_OAUTH_PUBLIC_URL=
FOXSKIN_OAUTH_FRONTEND_URL=
# QQ 互联（connect.qq.com）：AppID 配置后启用 QQ 登录，回调域需在控制台登记为 <PUBLIC_URL>/api/auth/oauth/qq/callback
FOXSKIN_OAUTH_QQ_CLIENT_ID=
FOXSKIN_OAUTH_QQ_CLIENT_SECRET=
# 通用 OIDC：Issuer 配置后启用，自动读取 /.well-known/openid-configuration
FOXSKIN_OAUTH_OIDC_ISSUER=
FOXSKIN_OAUTH_OIDC_CLIENT_ID=
FOXSKIN_OAUTH_OIDC_CLIENT_SECRET=
# 企业 SSO（参考 Keycloak）：与 OIDC 协议相同，但登录时按用户名/邮箱匹配本站已有账号自动绑定，可与 OIDC 同时启用
FOXSKIN_OAUTH_SSO_ISSUER=
FOXSKIN_OAUTH_SSO_CLIENT_ID=
FOXSKIN_OAUTH_SSO_CLIENT_SECRET=
# 无匹配账号时的落地策略（互斥）：false 拒绝登录（仅已有账号可用 SSO），true 自动建号
FOXSKIN_OAUTH_SSO_AUTO_PROVISION=false
# Microsoft 正版绑定：应用回调需登记为 <PUBLIC_URL>/api/auth/oauth/microsoft/callback；同时打开 MOJANG_AUTH_ENABLED
FOXSKIN_OAUTH_MICROSOFT_CLIENT_ID=
FOXSKIN_OAUTH_MICROSOFT_CLIENT_SECRET=
MOJANG_AUTH_ENABLED=false

# ===== TOTP 登录二次验证 =====
# 生产环境必须配置独立的随机值；加密密钥至少 32 字节（可使用 Base64）。
TOTP_ENCRYPTION_KEY=
TOTP_BACKUP_PEPPER=
TOTP_CHALLENGE_TTL_SECONDS=300
TOTP_MAX_CHALLENGE_ATTEMPTS=5
TOTP_ISSUER=FoxSkin
